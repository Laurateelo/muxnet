{
  "info": {
    "name": "实验三 统一响应与全局异常处理 29项测试",
    "description": "前12项对应指导书必做请求，13和14为两个选做请求，其余为补充验证。按顺序运行；数据库需为空且自增编号从1开始。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 新增张三",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/students",
        "description": "实测编号 1；预期业务 code = 200。请按顺序在新建空数据库中运行。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"张三\",\n  \"age\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response matches expected\", function () {",
              "  pm.expect(pm.response.json()).to.eql({\"code\": 200, \"msg\": \"成功\", \"data\": {\"id\": 1, \"name\": \"张三\", \"age\": 20}});",
              "});"
            ]
          }
        }
