<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F4F7F5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="商品详情" android:textSize="27sp" android:textStyle="bold" android:textColor="#173D32"/>
        <TextView android:id="@+id/detail_name" style="@style/DetailValue" android:layout_marginTop="40dp"
            android:textStyle="bold" android:textSize="30sp"/>
        <TextView android:id="@+id/detail_price" style="@style/DetailValue"/>
        <TextView android:id="@+id/detail_quantity" style="@style/DetailValue"/>
        <TextView android:id="@+id/detail_subtotal" style="@style/DetailValue" android:textStyle="bold" android:textColor="#236C5C"/>
        <Button android:id="@+id/btn_back" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="40dp" android:text="返回购物车" android:textColor="#FFFFFF" android:backgroundTint="#236C5C"/>
    </LinearLayout>
</ScrollView>
